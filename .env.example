# Optional local SQLite path. Leave unset on Vercel.
# STRIDE_DB_PATH=./data/stride.sqlite

# Set these in Vercel's Environment Variables; never commit real values.
# STRIDE_USERNAME=your-login-name
# STRIDE_PASSWORD=use-a-long-unique-password
# STRIDE_SESSION_SECRET=generate-at-least-32-random-bytes
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
